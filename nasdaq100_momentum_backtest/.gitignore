# Per backtest_rules.md: do not check in data, results, logs, .venv
data/**
results/
logs/
plots/
outputs/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Exception: seed price cache. The runner tops it up from here; it is not
# re-committed monthly, so each run fetches the tail since this commit.
!data/raw_prices/
!data/raw_prices/*.csv
!data/nasdaq100_membership.csv
!data/sp500_constituents.csv
